<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="container1">
    <%- include("partials/sidebar") %>

    <div class="header1">
        <h1 class="page-title">My Profile</h1>
    </div>

    <div class="content1">
        <div class="profile-shell">
            <div class="profile-banner"></div>

            <div class="profile-body">
                <form class="profile-photo-form" action="/uploadprofile" method="POST" enctype="multipart/form-data">
                    <div class="profile-avatar-wrap">
                        <% if (user && user.profile_photo) { %>
                            <img class="profile-avatar-lg" src="/profile/<%= user.profile_photo %>" alt="<%= user.name %>">
                        <% } else { %>
                            <div class="profile-avatar-lg profile-avatar-fallback">
                                <i class="fas fa-user"></i>
                            </div>
                        <% } %>

                        <label class="profile-camera-btn" title="Change photo">
                            <input type="file" name="profile_photo" accept="image/*" required>
                            <i class="fas fa-camera"></i>
                        </label>
                    </div>

                    <button type="submit" class="profile-photo-submit">
                        <i class="fas fa-cloud-arrow-up"></i>
                        Update Photo
                    </button>
                </form>

                <h2 class="profile-name"><%= user.name %></h2>
                <p class="profile-meta">
                    <i class="fas fa-phone"></i>
                    <%= user.mobile || user.mobile_number || "No mobile" %>
                </p>

                <div class="profile-divider"></div>

                <form class="profile-edit-form" action="/updateprofile" method="POST">
                    <p class="profile-edit-title">Edit Profile</p>
                    <label for="profile-name"> Name</label>
                    <div class="profile-edit-row">
                        <input id="profile-name" type="text" name="name" value="<%= user.name %>" placeholder="Enter your name" required>
                        <button type="submit">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
