<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set New PIN</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container">

        <div class="auth-forms-layer">

            <div class="form-panel login-panel">
                <div class="header">
                    <i class="fa-solid fa-lock"></i>
                    <h1>New PIN</h1>
                </div>

                <div class="content">
                    <form action="/newPIN" method="post">
                        <input type="hidden" name="user_id" value="<%= user_id %>">

                        <label><i class="fa-solid fa-lock"></i> New PIN</label>
                        <input type="password" name="pin" placeholder="Enter your new PIN" required>

                        <label><i class="fa-solid fa-lock"></i> Confirm PIN</label>
                        <input type="password" name="confirm_pin" placeholder="Confirm your new PIN" required>

                        <% if (message) { %>
                            <p class="auth-message"><%= message %></p>
                        <% } %>

                        <button type="submit">Set New PIN</button>
                        <a href="/login">Back to Login</a>
                    </form>
                </div>

                <div class="footer">
                    <p>All set?</p>
                    <a href="/login">Go to Login</a>
                </div>
            </div>

            <div class="form-panel register-panel" aria-hidden="true"></div>

        </div>

        <%- include("partials/welcome") %>

    </div>

</body>
</html>
